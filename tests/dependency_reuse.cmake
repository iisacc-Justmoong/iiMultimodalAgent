include("${HELPER}")
if(MODE STREQUAL "override")
    set(FETCHCONTENT_SOURCE_DIR_TEST "${ROOT}/custom")
endif()
ii_agent_reuse_dependency(FETCHCONTENT_SOURCE_DIR_TEST "${ROOT}" demo include/example.h)
if(MODE STREQUAL "valid" AND NOT FETCHCONTENT_SOURCE_DIR_TEST STREQUAL "${ROOT}/resources/dependencies/demo")
    message(FATAL_ERROR "Existing dependency was not selected")
elseif(MODE STREQUAL "override" AND NOT FETCHCONTENT_SOURCE_DIR_TEST STREQUAL "${ROOT}/custom")
    message(FATAL_ERROR "Explicit dependency override was changed")
elseif(MODE STREQUAL "missing" AND DEFINED FETCHCONTENT_SOURCE_DIR_TEST)
    message(FATAL_ERROR "A missing dependency should remain available for download")
endif()
