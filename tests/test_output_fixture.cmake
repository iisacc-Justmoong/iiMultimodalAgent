if(NOT RESOURCE_ROOT OR NOT OUTPUT_DIR)
    message(FATAL_ERROR "RESOURCE_ROOT and OUTPUT_DIR are required")
endif()
if(IS_SYMLINK "${RESOURCE_ROOT}" OR IS_SYMLINK "${OUTPUT_DIR}")
    message(FATAL_ERROR "Test output paths must not be symlinks")
endif()
cmake_path(ABSOLUTE_PATH RESOURCE_ROOT NORMALIZE OUTPUT_VARIABLE root)
cmake_path(ABSOLUTE_PATH OUTPUT_DIR NORMALIZE OUTPUT_VARIABLE output)
cmake_path(IS_PREFIX root "${output}" NORMALIZE inside)
if(NOT inside OR output STREQUAL root)
    message(FATAL_ERROR "Agent test output must be under the resource state directory")
endif()
if(ACTION STREQUAL "setup")
    file(MAKE_DIRECTORY "${OUTPUT_DIR}/tmp")
elseif(ACTION STREQUAL "cleanup")
    file(REMOVE_RECURSE "${OUTPUT_DIR}")
else()
    message(FATAL_ERROR "Unknown agent test fixture action")
endif()
