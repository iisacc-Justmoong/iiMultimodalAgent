# Preserve the public include namespace while authored files are grouped by responsibility.
foreach(_source_area IN ITEMS API Agent MCP Media/Detail Diagnostics)
    file(GLOB_RECURSE _headers CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/${_source_area}/*.h")
    foreach(_header IN LISTS _headers)
        get_filename_component(_name "${_header}" NAME)
        if(_source_area STREQUAL "API")
            set(_public_path "${_name}")
        elseif(_source_area STREQUAL "Agent")
            set(_public_path "agent/${_name}")
        elseif(_source_area STREQUAL "MCP")
            set(_public_path "mcp/${_name}")
        elseif(_source_area STREQUAL "Media/Detail")
            set(_public_path "detail/${_name}")
        else()
            set(_public_path "diagnostics/${_name}")
        endif()
        file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/include/iiMultimodalAgent/${_public_path}"
            CONTENT "#pragma once\n#include \"${_header}\"\n")
    endforeach()
endforeach()
