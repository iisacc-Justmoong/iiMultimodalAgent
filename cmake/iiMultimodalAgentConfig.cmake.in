@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/iiMultimodalAgentFailureDiagnosticsTargets.cmake")
set(iiMultimodalAgent_FailureDiagnostics_FOUND TRUE)
if(iiMultimodalAgent_FIND_COMPONENTS STREQUAL "FailureDiagnostics")
    check_required_components(iiMultimodalAgent)
    return()
endif()
set(_iimultimodalagent_package_prefix "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
find_dependency(iiLocalLLM 0.56 CONFIG)
find_dependency(iiDecision 0.0.3 CONFIG)
find_dependency(iiLocalDiffusion 0.6 CONFIG)
find_dependency(iiAudioGen 0.3 CONFIG)
find_dependency(iiVoiceOver 0.2 CONFIG)
find_dependency(iiFileProvider 0.6 CONFIG)
find_dependency(iiFileProviderNative 0.8.2 CONFIG)
find_dependency(Qt6 6.8.3 EXACT COMPONENTS Core Network)
set(PACKAGE_PREFIX_DIR "${_iimultimodalagent_package_prefix}")
unset(_iimultimodalagent_package_prefix)
include("${CMAKE_CURRENT_LIST_DIR}/iiMultimodalAgentTargets.cmake")
set_and_check(IIMULTIMODALAGENT_QML_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/iiMultimodalAgent/qml")
check_required_components(iiMultimodalAgent)
